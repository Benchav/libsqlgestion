# =============================================================================
# LibSQLite Backend Configuration
# =============================================================================

# Encryption key for database tokens (64-char hex = 32 bytes for AES-256-GCM)
# Auto-generated if left empty on first start.
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server port and database paths
PORT=5000
DATABASE_FILE=/app/data/control.db
SQLITE_STORAGE_ROOT=/app/data/sqlite
CORS_ORIGIN=http://localhost:5001

# Public URL Routing & Traefik Integration
# For Cloudflare Tunnel wildcard, set your root domain (e.g. yourdomain.com)
DATABASE_PUBLIC_DOMAIN=
DATABASE_PUBLIC_HOST=host.docker.internal
DATABASE_PUBLIC_PROTOCOL=http

# LibSQL Docker Runtime Orchestration
LIBSQL_SERVER_IMAGE=ghcr.io/tursodatabase/libsql-server:latest
LIBSQL_PROVISION_ASYNC=true
DOCKER_SOCKET_PATH=/var/run/docker.sock
MAX_UPLOAD_SIZE_BYTES=524288000

# Connection Pool & High Performance Tuning
DB_CONNECTION_POOL_MAX_SIZE=256
DB_CONNECTION_POOL_IDLE_TTL_MS=1800000
SQLITE_PERFORMANCE_PROFILE=performance
AUTHZ_CACHE_TTL_MS=30000
ALLOW_PUBLIC_REGISTRATION=true
