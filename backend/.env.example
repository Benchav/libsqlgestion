# =============================================================================
# LibSQLite Backend Configuration
# =============================================================================

# Encryption key for database tokens (64-char hex = 32 bytes for AES-256-GCM)
# Auto-generated if left empty on first start.
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server port and database paths
PORT=5000
DATABASE_FILE=/app/data/control.db
SQLITE_STORAGE_ROOT=/app/data/sqlite
CORS_ORIGIN=http://localhost:5001

# Public URL Routing & Traefik Integration
# For Cloudflare Tunnel wildcard, set your root domain (e.g. yourdomain.com)
DATABASE_PUBLIC_DOMAIN=
DATABASE_PUBLIC_HOST=host.docker.internal
DATABASE_PUBLIC_PROTOCOL=http

# Public base URL used by LOCAL-FILE databases to build their URL + token
# endpoint. Example: DATABASE_PUBLIC_BASE_URL=https://libsql.example.com
# It can also be configured from the panel under Settings -> Public Database
# Routing -> Base URL.
DATABASE_PUBLIC_BASE_URL=

# Dedicated parent domain for sqld namespaces. Keep it separate from
# DATABASE_PUBLIC_DOMAIN so the namespace wildcard does not capture the
# subdomains used by your applications.
SQLD_PUBLIC_DOMAIN=

# Exact public host for a single shared sqld namespace. The first DNS label
# must match the namespace. This is also used by the backend to consider the
# namespace publicly routable, and by docker-compose.yml for the exact router.
# Example: LIBSQL_NAMESPACE_HOST=erp-db.data.example.com
# Leave empty when using dedicated runtimes or the wildcard override.
LIBSQL_NAMESPACE_HOST=

# Traefik certificate resolver used by dedicated runtimes and by the exact
# shared-namespace router. In Coolify this is usually "letsencrypt".
# Leave empty if your Traefik already has a wildcard certificate for the hosts.
TRAEFIK_CERT_RESOLVER=
# Coolify's Traefik uses "http" and "https" as entrypoint names. A plain
# Traefik installation may use "websecure" instead.
TRAEFIK_ENTRYPOINT=https
# DNS-01 resolver capable of issuing *.SQLD_PUBLIC_DOMAIN for wildcard namespaces.
# Used by docker-compose.wildcard.yml; HTTP-01 cannot issue wildcard certs.
TRAEFIK_WILDCARD_CERT_RESOLVER=

# How the "Make public libSQL" action publishes a LOCAL-FILE database:
# runtime   = dedicated libsql-server container
# namespace = shared sqld namespace (host-based, supports embedded replicas)
# auto      = namespace when public routing is ready, otherwise runtime
LIBSQL_CONVERSION_MODE=auto

# LibSQL Docker Runtime Orchestration
LIBSQL_SERVER_IMAGE=ghcr.io/tursodatabase/libsql-server:latest
# false = wait for the libSQL container and return its real JWT in the import/create response.
# true  = provision in the background; use Rotate Token after the database becomes active.
LIBSQL_PROVISION_ASYNC=false
LIBSQL_RUNTIME_TOKEN_TTL_SECONDS=31536000
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Docker network shared by the backend, Traefik and dedicated libSQL runtimes.
# Leave empty to detect it from the backend container (prefers "coolify").
# The runtime is never created on the default bridge network: provisioning
# fails instead. In Coolify set this to "coolify".
LIBSQL_RUNTIME_NETWORK=
# Proxy container used to verify that the runtime shares a Docker network with
# Traefik. Defaults to "coolify-proxy".
LIBSQL_PROXY_CONTAINER_NAME=
# Override only when HOSTNAME/os.hostname() does not identify the backend
# container (for example when running the backend outside the Docker network).
LIBSQL_BACKEND_CONTAINER_ID=
# Upload staging directory. Keep it on the same volume as /app/data so the
# import does not copy the file between filesystems. Defaults to <data>/tmp.
IMPORT_STAGING_DIR=
MAX_UPLOAD_SIZE_BYTES=524288000

# Legacy auto import strategy. Only used when LIBSQL_REQUIRE_PRIMARY=false.
# With the default libSQL-first policy, imports are selected by
# LIBSQL_PRIMARY_MODE instead.
LIBSQL_NAMESPACE_IMPORTS=false

# Legacy: provision a dedicated libSQL container for auto imports when
# LIBSQL_REQUIRE_PRIMARY=false. Ignored by the libSQL-first policy.
LIBSQL_IMPORT_RUNTIME=false

# libSQL-first policy. New databases and imports must be real libSQL primaries.
# Set these to true/false to emulate Turso Cloud by default.
LIBSQL_REQUIRE_PRIMARY=true
LIBSQL_ALLOW_LOCAL_FILE=false

# Primary selection for new databases/imports:
# namespace = shared sqld, runtime = dedicated libsql-server, auto = namespace
# when public routing is enabled and available, otherwise runtime.
LIBSQL_PRIMARY_MODE=auto

# Namespace public routing. Set true after wildcard TLS + proxy routing exist.
# For a single exact host, set LIBSQL_NAMESPACE_HOST above; the exact host
# enables public routing for that host even when the wildcard flag is false.
LIBSQL_NAMESPACE_PUBLIC_ENABLED=false

# UID/GID used by the official libsql-server image. Imported namespace files are
# chowned to this user so sqld can open them read-write.
SQLD_UID=666
SQLD_GID=666

# Connection Pool & High Performance Tuning
DB_CONNECTION_POOL_MAX_SIZE=256
DB_CONNECTION_POOL_IDLE_TTL_MS=1800000
SQLITE_PERFORMANCE_PROFILE=performance

# Query safety limits (Studio and API)
SQL_QUERY_TIMEOUT_MS=15000
QUERY_HARD_MAX_ROWS=1000

# Schema cache keyed by PRAGMA schema_version. One cheap version query avoids
# re-reading every table's metadata on repeated Studio opens.
SCHEMA_CACHE_TTL_MS=60000
SCHEMA_CACHE_MAX_ENTRIES=200

# Docker stats are sampled in the background and served from this short cache.
METRICS_CACHE_TTL_MS=5000

# Persisted runtime health is refreshed outside request handlers and survives
# backend restarts.
RUNTIME_HEALTH_INTERVAL_MINUTES=10
RUNTIME_HEALTH_PUBLIC_TIMEOUT_MS=5000
RUNTIME_HEALTH_STARTUP_DELAY_SECONDS=20
RUNTIME_HEALTH_CONCURRENCY=4

# Usage analytics
ANALYTICS_ENABLED=true
ANALYTICS_RAW_RETENTION_DAYS=14
ANALYTICS_FLUSH_INTERVAL_MS=1000
ANALYTICS_MAX_QUEUE=10000
ANALYTICS_STORAGE_SAMPLE_MINUTES=60
ANALYTICS_STORAGE_RETENTION_DAYS=90
ANALYTICS_TRAFFIC_ENABLED=true

# Snapshots / restore points. SQLite uses VACUUM INTO; managed libSQL
# primaries use the engine's /dump endpoint and are replay-verified.
SNAPSHOTS_ENABLED=true
SNAPSHOT_LIBSQL_ENABLED=true
SNAPSHOT_LIBSQL_VERIFY_REPLAY=true
SNAPSHOT_LIBSQL_MAX_BYTES=10737418240
SNAPSHOT_LIBSQL_DUMP_TIMEOUT_MS=900000
SNAPSHOT_INTERVAL_MINUTES=60
SNAPSHOT_FULL_WINDOW_HOURS=24
SNAPSHOT_SIX_HOURLY_WINDOW_HOURS=72
SNAPSHOT_RETENTION_DAYS=14
SNAPSHOT_SCHEDULER_TICK_MINUTES=5
SNAPSHOT_TIMEZONE=UTC
SNAPSHOT_MAX_CONCURRENT=1
SNAPSHOT_MIN_FREE_BYTES=1073741824
SNAPSHOT_STALE_MINUTES=30
SNAPSHOT_VERIFY_ON_RESTORE=true
# Defaults to ${SQLITE_STORAGE_ROOT}/snapshots when omitted.
SNAPSHOT_STORAGE_ROOT=/app/data/sqlite/snapshots

# Defaults for new per-database backup policies. Existing policies are managed
# from the database detail page and are not overwritten by these values.
SNAPSHOT_DAILY_ENABLED=true
SNAPSHOT_DAILY_AT_HOUR=2
SNAPSHOT_DAILY_RETENTION=14
SNAPSHOT_WEEKLY_ENABLED=false
SNAPSHOT_WEEKLY_DAY=0
SNAPSHOT_WEEKLY_AT_HOUR=2
SNAPSHOT_WEEKLY_RETENTION=8
SNAPSHOT_MONTHLY_ENABLED=false
SNAPSHOT_MONTHLY_DAY=1
SNAPSHOT_MONTHLY_AT_HOUR=2
SNAPSHOT_MONTHLY_RETENTION=12
AUTHZ_CACHE_TTL_MS=30000
ALLOW_PUBLIC_REGISTRATION=true
