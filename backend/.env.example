MASTER_KEY=

PORT=5000
DATABASE_FILE=/app/data/control.db
SQLITE_STORAGE_ROOT=/app/data/sqlite
CORS_ORIGIN=http://localhost:3001

DATABASE_PUBLIC_HOST=host.docker.internal
DATABASE_PUBLIC_PROTOCOL=http
DATABASE_PUBLIC_DOMAIN=
LIBSQL_SERVER_IMAGE=ghcr.io/tursodatabase/libsql-server:latest
LIBSQL_PROVISION_ASYNC=true

DOCKER_SOCKET_PATH=/var/run/docker.sock
MAX_UPLOAD_SIZE_BYTES=524288000

DB_CONNECTION_POOL_MAX_SIZE=256
DB_CONNECTION_POOL_IDLE_TTL_MS=1800000
SQLITE_PERFORMANCE_PROFILE=performance
AUTHZ_CACHE_TTL_MS=30000
ALLOW_PUBLIC_REGISTRATION=true
